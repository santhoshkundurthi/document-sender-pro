# Browser-safe provider preferences only. These values select the provider shown
# in the demo; they do not enable live message delivery.
VITE_EMAIL_PROVIDER_PREFERRED=mailtrap
VITE_SMS_PROVIDER_PREFERRED=twilio
VITE_WHATSAPP_PROVIDER_PREFERRED=gupshup

# Public sender identity defaults used by the email form.
VITE_SENDGRID_FROM_NAME=My Application
VITE_SENDGRID_FROM_EMAIL=noreply@example.com
VITE_SENDGRID_REPLY_TO=support@example.com

# Configure API endpoints and credentials on a backend only.
# Do not prefix secrets with VITE_: browser-exposed variables are visible to users.
SENDGRID_API_BASE_URL=https://api.sendgrid.com/v3
SENDGRID_ENDPOINT=/mail/send
SENDGRID_API_KEY=configure-on-server

BREVO_API_BASE_URL=https://api.brevo.com/v3
BREVO_ENDPOINT=/smtp/email
BREVO_API_KEY=configure-on-server

MSG91_API_BASE_URL=https://control.msg91.com/api/v5
MSG91_ENDPOINT=/flow
MSG91_AUTH_KEY=configure-on-server

TWILIO_API_BASE_URL=https://api.twilio.com/2010-04-01
TWILIO_ACCOUNT_SID=configure-on-server
TWILIO_AUTH_TOKEN=configure-on-server
TWILIO_ENDPOINT_SUFFIX=/Messages.json

GUPSHUP_API_BASE_URL=https://api.gupshup.io/whatsapp/
GUPSHUP_ENDPOINT=/msg
GUPSHUP_API_KEY=configure-on-server

WATI_API_BASE_URL=https://live-server-XXXX.wati.io
WATI_ENDPOINT=/sendSessionMessage/
WATI_API_KEY=configure-on-server

# Mailtrap test-email integration. Keep these server-only (never use VITE_).
# Comma-separated allowlists restrict the sender and preview-contact recipients.
MAILTRAP_API_TOKEN=replace-with-your-mailtrap-api-token
MAILTRAP_ALLOWED_FROM_EMAILS=noreply@example.com
MAILTRAP_ALLOWED_RECIPIENTS=you@example.com
